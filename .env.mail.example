# Copier ces réglages dans .env.local et redémarrer le site.
# Compte d’envoi SMTP — ne jamais utiliser de préfixe VITE_ pour un secret.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ritapokou12@gmail.com
SMTP_PASS=
SMTP_FROM="Rital Events <ritapokou12@gmail.com>"
CONTACT_TO=ritapokou12@gmail.com
# Gmail nécessite un mot de passe d’application, pas le mot de passe habituel.
# Si vous reprenez un autre service, utiliser son hôte SMTP et ses identifiants.
